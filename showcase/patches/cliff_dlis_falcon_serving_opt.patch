+
+Preserves 100% bitwise-identical token IDs and the exact [0, len(content)]
+binary-search route (head 75% + TRUNCATION_MARKER + tail 25%) while cutting
+binary-search CPU cost under self._tok_lock by ~2.4x-10x:
+  1. Computes the constant assistant-turn suffix token delta
+     (extra = len(full_ids) - len(prompt_ids) = 5 tokens for {"role":"assistant","content":"{}"})
+     once per (id(tokenizer), system_prompt).
+  2. Performs 1 apply_chat_template + 1 tokenizer() call per binary-search
+     probe instead of 2 + 2, and reuses `best_pids` when `high == low - 1`
+     instead of re-tokenizing at the end of `truncate_content_to_fit` +
+     `prepare_prompt_ids` (reducing 37 full ~8k-token tokenizations -> 19).
+  3. Optional bounded 512-entry dict cache (`_REQ_CACHE`), controlled by
+     `CLIFF_FAST_PROMPT_NO_CACHE=1` (disable cache) or default enabled.
+"""

 import json
+import os
 import re

 TRUNCATION_MARKER = "\n\n[... content truncated for training ...]\n\n"

 HEAD_FRACTION = 0.75

+_SYS_EXTRA_CACHE: dict[tuple[int, str], int] = {}
+_REQ_CACHE: dict[tuple[str, str, int], tuple[list[int], bool]] = {}
+_REQ_CACHE_MAX = int(os.environ.get("CLIFF_REQ_CACHE_MAX", "512"))
+
+
+def _get_assistant_extra(tokenizer, sys_prompt: str) -> int:
+    key = (id(tokenizer), sys_prompt)
+    val = _SYS_EXTRA_CACHE.get(key)
+    if val is not None:
+        return val
+    m_base = [
+        {"role": "system", "content": sys_prompt},
+        {"role": "user", "content": "{}"},
+    ]
+    m_full = m_base + [{"role": "assistant", "content": "{}"}]
+    p_str = tokenizer.apply_chat_template(
+        m_base, tokenize=False, add_generation_prompt=True, enable_thinking=False
+    )
+    f_str = tokenizer.apply_chat_template(
+        m_full, tokenize=False, add_generation_prompt=False, enable_thinking=False
+    )
+    p_ids = tokenizer(p_str, add_special_tokens=False).input_ids
+    f_ids = tokenizer(f_str, add_special_tokens=False).input_ids
+    extra = len(f_ids) - len(p_ids)
+    _SYS_EXTRA_CACHE[key] = extra
+    return extra
+
