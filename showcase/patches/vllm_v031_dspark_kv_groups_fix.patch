+    # Fix 34-KV-cache-group fragmentation when an external speculative draft
+    # model (e.g. DSpark 2L with 1 sliding_attention + 1 full_attention layer)
+    # introduces a singleton spec bucket alongside a hybrid Mamba+FullAttention
+    # target (e.g. Qwen3.5-4B: 24 Mamba + 8 full_attention). Exclude draft-only
+    # singleton buckets when computing the target n:1 group_size.
+    non_draft_counts = [
+        len(layers) for layers in same_type_layers.values()
+        if not all("drafter" in name or "mtp" in name for name in layers)
