{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourceFilterResult",
  "description": "Relevance verdicts for research fragments",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content_id": {
            "type": "string",
            "description": "The fragment content_id being judged"
          },
          "verdict": {
            "type": "string",
            "enum": ["relevant", "off_topic"],
            "description": "Whether the fragment is relevant to the section"
          },
          "reason": {
            "type": "string",
            "description": "One sentence explaining the verdict"
          }
        },
        "required": ["content_id", "verdict", "reason"],
        "additionalProperties": false
      },
      "description": "Per-fragment relevance verdicts"
    }
  },
  "required": ["results"],
  "additionalProperties": false
}
